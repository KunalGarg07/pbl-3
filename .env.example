# Copy to .env and fill in. Never commit .env. Every setting has a default (codeguard/config.py).
# Keep the submitted source code in the scan history database (default: off)
CODEGUARD_STORE_SOURCE=false
# Where the SQLite history database lives
CODEGUARD_DB_PATH=codeguard_data/scans.db
# Maximum upload size in bytes
CODEGUARD_MAX_BYTES=200000
# Seconds before a Bandit run is stopped
CODEGUARD_BANDIT_TIMEOUT=30

# LLM provider for explanations ("ollama" or "anthropic")
CODEGUARD_LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
CODEGUARD_LLM_TIMEOUT=180
ANTHROPIC_API_KEY=
